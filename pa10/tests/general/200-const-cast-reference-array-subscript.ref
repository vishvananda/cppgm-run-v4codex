global @__constant_array_0 [storage=readonly, binding=internal] = {
  i8 1
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $data : obj<2x1>
  slot $r : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $data
    copyobj 2x1 @__constant_array_0, %t1
    %t3 = addr $data
    %t4 = index i8 [projection=array_element] %t3, 0
    store ptr %t4, $r
    %t5 = load ptr $r
    %t6 = load i8 %t5
    %t7 = convert sext i32 i8 %t6
    %t8 = cmp eq i32 %t7, 1
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t9 = load i32 $cond__1
    return i32 %t9
}
