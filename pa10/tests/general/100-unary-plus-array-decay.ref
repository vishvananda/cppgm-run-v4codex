global @__constant_array_0 [storage=readonly, binding=internal] = {
  i32 3
  i32 4
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<8x4>
  slot $p : ptr

  block ^entry:
    %t1 = addr $a
    copyobj 8x4 @__constant_array_0, %t1
    %t3 = addr $a
    store ptr %t3, $p
    %t4 = load ptr $p
    %t5 = index i32 [projection=array_element] %t4, 1
    %t6 = load i32 %t5
    %t7 = binary sub i32 %t6, 4
    return i32 %t7
}
