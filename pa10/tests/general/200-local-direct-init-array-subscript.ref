global @__constant_array_0 [storage=readonly, binding=internal] = {
  i32 1
  i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>
  slot $x : i32

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constant_array_0, %t1
    %t3 = addr $values
    %t4 = index i32 [projection=array_element] %t3, 0
    %t5 = load i32 %t4
    store i32 %t5, $x
    %t6 = load i32 $x
    %t7 = binary sub i32 %t6, 1
    return i32 %t7
}
